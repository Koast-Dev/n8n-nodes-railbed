            "index": 0
          }
        ]
      ]
    },
    "Mark order fulfilled": {
      "main": [
        [
          {
            "node": "Post in #sales",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
